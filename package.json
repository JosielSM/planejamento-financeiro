{
  "name": "planejamento-financeiro",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "node src/server.mjs",
    "dev:cloudflare": "npm run build:mobile && wrangler dev",
    "deploy:cloudflare:check": "npm run build:mobile && wrangler deploy --dry-run",
    "deploy:cloudflare": "npm run build:mobile && wrangler deploy",
    "cloudflare:types": "wrangler types worker-configuration.d.ts",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:sync": "npm run build:mobile && cap sync android",
    "cap:open": "cap open android",
    "android:debug": "npm run cap:sync && cd android && gradlew.bat assembleDebug",
    "android:release": "node scripts/release-android.mjs",
    "test": "npm run test:offline && node scripts/test-accumulated-balance.mjs && node scripts/test-security-contract.mjs && node --check src/server.mjs && node --check public/js/02-data.js && node --check public/js/03-dashboard.js && node --check public/js/07-events.js && node --check public/js/08-platform.js && node --check public/service-worker.js",
    "test:offline": "node scripts/test-offline-sync.mjs",
    "migrate:firebase-users": "node scripts/migrate-users-to-firebase.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.16.0",
    "helmet": "^8.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide": "^0.468.0",
    "pg": "^8.12.0"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@cloudflare/workers-types": "^5.20260901.1",
    "firebase-admin": "^14.3.0",
    "wrangler": "^4.128.0"
  }
}
